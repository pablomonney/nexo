{
  "name": "accounting-ai-argentina",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de contabilidad inteligente para Argentina — motor contable determinístico con capa de IA",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:arch": "depcruise packages apps --config .dependency-cruiser.cjs",
    "check:no-float": "node scripts/check-no-float.mjs",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:status": "node scripts/migrate.mjs status",
    "db:reset": "node scripts/migrate.mjs reset",
    "norms:verify": "node scripts/verify-norm-archive.mjs",
    "verify": "npm run typecheck && npm run lint && npm run lint:arch && npm run check:no-float && npm run norms:verify && npm run ledger:verify && npm run audit:invariants && npm run test:coverage",
    "db:create": "node scripts/db-create.mjs",
    "db:setup": "npm run db:create && npm run db:migrate && npm run build && npm run catalog:seed && npm run prompts:register && npm run norms:seed && npm run tax:seed && npm run statements:seed",
    "arca:check": "node scripts/arca-check.mjs",
    "catalog:seed": "node scripts/seed-comprobante-types.mjs",
    "metrics:extraction": "node scripts/extraction-metrics.mjs",
    "prompts:register": "node scripts/register-prompts.mjs",
    "test:coverage": "vitest run --coverage",
    "norms:seed": "node scripts/seed-norms.mjs",
    "ledger:verify": "node scripts/verify-ledger.mjs",
    "statements:seed": "node scripts/seed-statement-templates.mjs",
    "audit:invariants": "node scripts/check-invariants.mjs",
    "arca:capabilities": "node scripts/arca-capabilities.mjs",
    "norms:watch": "node scripts/norms-watch.mjs",
    "tax:seed": "node scripts/seed-tax-rates.mjs",
    "sandbox:create": "node scripts/sandbox.mjs create",
    "sandbox:run": "node scripts/sandbox.mjs run",
    "sandbox:status": "node scripts/sandbox.mjs status",
    "comprobantes:revisar": "node scripts/revisar-comprobantes.mjs",
    "cuit:anonimizar": "node scripts/anonimizar-cuit.mjs",
    "comprobantes:generar": "node scripts/generar-comprobantes-homologacion.mjs",
    "comprobantes:tipos": "node scripts/sincronizar-tipos-comprobante.mjs",
    "test:db": "node scripts/test-db.mjs",
    "reglas:cargar": "node scripts/cargar-reglas-contables.mjs",
    "reglas:aprobar": "node scripts/aprobar-regla.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/node-forge": "^1.3.11",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "2.1.9",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "pdfkit": "^0.20.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "9.0.3",
    "@node-rs/argon2": "2.0.2",
    "fast-xml-parser": "4.5.1",
    "fastify": "5.2.1",
    "node-forge": "1.3.1",
    "zod": "3.24.1"
  }
}
