# Copiar a .env y completar. .env está en .gitignore y NUNCA se commitea.
# SECURITY.md §5: los secretos no viven en el repositorio ni en la imagen.

# ── Base de datos ────────────────────────────────────────────────────────────
# En producción la aplicación conecta con un rol SIN BYPASSRLS (ver 0009_rls.sql).
DATABASE_URL=postgres://aai:aai@localhost:5433/aai

# ── Colas ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── Object storage ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=aai-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Proveedor de IA ──────────────────────────────────────────────────────────
# El sistema es agnóstico del proveedor (§28). Dejar vacío deshabilita las
# sugerencias: el sistema sigue siendo un software contable funcional.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# ── OCR ──────────────────────────────────────────────────────────────────────
# 'local' usa Tesseract en el propio host. Los documentos contables son secreto
# profesional: debe existir la opción de no enviarlos a un tercero.
OCR_PROVIDER=local

# ── ARCA ─────────────────────────────────────────────────────────────────────
# NUNCA se guarda acá la clave privada ni la Clave Fiscal del contribuyente.
# Los certificados X.509 por empresa se cifran con KMS y se guardan en la base.
# Esta variable apunta al gestor de secretos, no al secreto.
ARCA_KMS_KEY_ID=
ARCA_ENVIRONMENT=homologacion
