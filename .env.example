# Copiar a .env y completar. .env está en .gitignore y NUNCA se commitea.
# SECURITY.md §5: los secretos no viven en el repositorio ni en la imagen.
#
# Este archivo y el código dicen lo mismo, y hay un control que lo comprueba:
# `tests/security/configuracion-declarada.test.ts` (S-38) falla si acá aparece
# una variable que nadie lee, o si el código lee una que acá no está. La
# auditoría B-2 lo encontró desincronizado en los dos sentidos —prometía un
# Redis y un S3 que nada usa, y callaba las tres que deciden si el servidor
# arranca—, y una plantilla equivocada no se lee como un error: se lee como una
# instrucción.
#
# La referencia larga, con la consecuencia de cada valor por omisión, está en
# docs/DESPLIEGUE.md §2.

# ── Base de datos ────────────────────────────────────────────────────────────
# En producción la aplicación conecta con un rol SIN BYPASSRLS (ver 0009_rls.sql).
DATABASE_URL=postgres://aai:aai@localhost:5433/aai

# ── Sandbox de simulación (§34) ───────────────────────────────────────────────
# Variable APARTE de DATABASE_URL a propósito: un sandbox que se configura
# cambiando la misma variable se convierte en producción con un olvido.
# El nombre de la base tiene que empezar con sandbox_ y la crea npm run sandbox:create,
# que aplica las MISMAS migraciones y deja una marca que ninguna migración de
# producción crea. Sin esa marca, npm run sandbox:run se niega a correr.
SANDBOX_DATABASE_URL=postgres://aai:aai@localhost:5433/sandbox_aai

# ── El proceso ───────────────────────────────────────────────────────────────
# NODE_ENV no está acá porque la pone el orquestador, no el archivo. En
# producción **tiene que valer `production`**: es lo que endurece el manejo de
# credenciales —entre otras cosas, ARCA se niega a abrir una clave privada
# envuelta con una llave del entorno—, activa el `secure` de la cookie de sesión
# y agrega la cabecera HSTS.
PORT=3001

# ¿Hay un proxy de confianza adelante? Vale `true` o cualquier otra cosa.
#
# **Hay que decidirlo antes de desplegar**, porque los dos valores fallan en
# silencio del lado equivocado:
#
#   sin proxy y en `true`   cualquiera manda X-Forwarded-For y se inventa su
#                           dirección: el límite de intentos deja de servir.
#   con proxy y en `false`  `request.ip` es la del proxy PARA TODOS, así que el
#                           límite por origen se vuelve global: treinta fallos
#                           de cualquiera dejan afuera al resto.
#
# Se pone en `true` si y solo si hay un proxy delante que **reescriba**
# X-Forwarded-For y no deje pasar la que venga de afuera. Todo despliegue con
# TLS terminado por el proveedor está en ese caso.
TRUST_PROXY=false

# Qué versión está corriendo. La pone el despliegue —el hash del commit, la
# etiqueta de la imagen— y aparece en `GET /health`. Si falta se informa `null`:
# no se inventa un número, porque una versión inventada hace concluir que dos
# entornos son el mismo cuando nadie lo comprobó.
BUILD_ID=

# ── Sesión y límite de intentos ──────────────────────────────────────────────
# Los valores de acá son los de por omisión. LOGIN_RATE_PER_MINUTE cuenta
# intentos FALLIDOS por minuto y por origen, y es **por proceso**: con varias
# réplicas el límite efectivo se multiplica por la cantidad de réplicas.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILED=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_PER_MINUTE=30

# ── Segundo factor ───────────────────────────────────────────────────────────
# MFA_ENCRYPTION_KEY cifra el secreto TOTP en reposo: 32 bytes en base64.
#
# **En producción es obligatoria y sin ella el servidor no arranca.** Fuera de
# producción, si falta se deriva una al azar en cada arranque, con la
# consecuencia asumida de que los segundos factores ya configurados dejan de
# validar al reiniciar.
#
# Generarla:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
# El nombre que muestra la aplicación de códigos.
MFA_ISSUER=Contabilidad AI

# ── Métricas ─────────────────────────────────────────────────────────────────
# Sin este token `GET /metrics` **no existe**: contesta 404. No se deja abierto
# «porque son solo contadores» —dicen cuántas empresas operan, a qué hora y con
# qué volumen— ni se inventa un valor por omisión. La contracara es que un
# despliegue que no lo declare queda **sin observabilidad y sin avisar**.
METRICS_TOKEN=

# ── Bitácora ─────────────────────────────────────────────────────────────────
# Guardar la IP en la bitácora tiene consecuencias legales: es un dato personal.
# Por omisión no se guarda.
AUDIT_RECORD_IP=false

# ── Documentos ───────────────────────────────────────────────────────────────
# **No hay object storage.** Los documentos van al sistema de archivos, y por eso
# no hay variables de S3 acá: las había, y no las leía nadie. Quien levantara un
# bucket y las completara habría creído que los comprobantes de sus clientes
# viajaban ahí.
#
# En un contenedor esta ruta **tiene que ser un volumen**: adentro de la imagen
# los documentos se pierden en el próximo despliegue. La documentación
# respaldatoria tiene plazos legales de guarda —ver docs/DESPLIEGUE.md §5—.
DOCUMENT_STORAGE_PATH=./var/documents
DOCUMENT_MAX_BYTES=26214400

# ── Colas ────────────────────────────────────────────────────────────────────
# No hay variable acá, y es información: **no hay colas**. Había un REDIS_URL que
# ningún archivo leía. Lo periódico —el ciclo de facturación, las copias, la
# vigilancia de normas— son comandos que hoy alguien agenda afuera; cuáles y cada
# cuánto está en docs/DESPLIEGUE.md §4.

# ── Proveedor de IA ──────────────────────────────────────────────────────────
# El sistema es agnóstico del proveedor (§28).
#
# Tres valores, y ninguno más. Un valor desconocido NO cae a `none`: el servidor
# no arranca. Un typo que degrada en silencio es peor que un arranque fallido —
# el sistema diría que tiene IA y no la tendría, y nadie iría a buscar por qué
# no aparecen las sugerencias.
#
#   none  sin IA externa. Es el valor por defecto y es un MODO DE OPERACIÓN:
#         las sugerencias salen de lo que la propia empresa ya aprobó, sin
#         mandar un solo documento afuera. El sistema sigue siendo un software
#         contable completo.
#   mock  el simulado, que se abstiene siempre. Para desarrollo y tests.
#   http  el adaptador HTTP contra un proveedor real.
AI_PROVIDER=none

# Las tres que `http` necesita. Sin alguna de ellas el estado es
# «preparado, no conectado», y el arranque lo dice con esas palabras.
# La credencial NUNCA se loguea, no se persiste y no viaja en ningún error.
#
# Hay dos formas de dar la clave, y la de abajo es la preferida:
#
#   AI_API_KEY_REF=env:AI_API_KEY   la referencia: dónde está
#   AI_API_KEY=sk-...               el valor, acá mismo
#
# Poner solo AI_API_KEY sigue andando: el arranque deduce `env:AI_API_KEY`. La
# forma con referencia existe porque el día que haya un gestor de secretos, lo
# único que cambia es el prefijo (`kms:` en lugar de `env:`) y ninguna otra
# línea del sistema se entera. Ver SECURITY.md §5.
AI_API_KEY_REF=
AI_API_KEY=
AI_MODEL_ID=
AI_BASE_URL=

# Técnicas, con valores por defecto sensatos.
# El timeout es por intento; los reintentos son ADEMÁS del primero y solo
# aplican a 429, 5xx y fallos de red — un 400 sale igual mil veces.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# Preguntas por minuto y por usuario. Es un tope técnico contra el bucle, no
# contra el gasto: el gasto lo gobierna el cupo diario por empresa, que se
# declara en `ai_quotas` y no tiene valor por defecto.
AI_PREGUNTAS_POR_MINUTO=20

# ── OCR ──────────────────────────────────────────────────────────────────────
# La variable se llama OCR_ENGINE. Decía OCR_PROVIDER, que no la lee nadie, y
# prometía un Tesseract local que no está conectado: dos afirmaciones falsas en
# tres líneas, encontradas por la auditoría B-2.
#
#   none  no hay motor. Es el valor por defecto: los documentos se archivan y la
#         extracción informa `SIN_MOTOR_OCR`, que es la verdad.
#   mock  el simulado, para desarrollo y tests.
#
# **No hay un motor real conectado todavía.** Cuando lo haya, la decisión que
# importa es dónde corre: los documentos contables son secreto profesional y
# tiene que existir la opción de no mandarlos a un tercero.
OCR_ENGINE=none

# ── Gestor de secretos ───────────────────────────────────────────────────────
# Quién resuelve una referencia de secreto en una credencial. Tres valores, y
# un valor desconocido NO cae al de por defecto: el servidor no arranca.
#
#   env   las del despliegue salen de variables de entorno. Es el de por
#         defecto. Se NIEGA a resolver un secreto por empresa: obligaría a
#         reiniciar el proceso para dar de alta un cliente y dejaría las
#         credenciales de todas en el mismo lugar.
#   none  no se resuelve ninguno. Para tests y para un despliegue sin
#         integraciones externas.
#   kms   un gestor externo. **Todavía no hay ninguno conectado**: elegirlo con
#         este valor hace fallar el arranque a propósito, con el motivo escrito.
#
# NEXO guarda la REFERENCIA, no el valor: `secret_refs` no tiene columna donde
# poner material. Ver SECURITY.md §5 y docs/DESPLIEGUE.md §4.1.
SECRETS_PROVIDER=env

# ── Correo ───────────────────────────────────────────────────────────────────
# Quién manda el correo. Dos valores, y ninguno más. Un valor desconocido NO cae
# a `none`: el servidor no arranca, por lo mismo que AI_PROVIDER y
# SECRETS_PROVIDER. Acá el silencio sería el más caro de los tres: un typo no
# rompe nada visible —el alta contesta 200— y el síntoma es que los usuarios
# nunca confirman su cuenta.
#
#   none    sin proveedor. Es el valor por defecto y **es un modo de
#           operación**: lo que se encola queda en `email_outbox` con estado
#           SIN_PROVEEDOR —que no es lo mismo que FALLIDO: el primero dice que
#           falta contratar algo, el segundo que el mensaje o la dirección
#           tienen un problema—. El alta autoservicio NO se completa sola: el
#           operador lee la bandeja con `npm run correo:bandeja`.
#   resend  el adaptador HTTP contra Resend.
#
# La aplicación puede encolar y NO puede leer `email_outbox`: el cuerpo de un
# mensaje de verificación lleva el token. Eso no cambia con proveedor conectado.
EMAIL_PROVIDER=none

# Las dos que `resend` necesita. Sin alguna de ellas el estado es «preparado, no
# conectado», el arranque lo dice nombrando la que falta, y el alta sigue
# funcionando contra la bandeja de salida.
#
# La credencial NUNCA se loguea, no se persiste y no viaja en ningún error.
# Mismas dos formas que la de IA, y la de la referencia es la preferida:
#
#   EMAIL_API_KEY_REF=env:EMAIL_API_KEY   la referencia: dónde está
#   EMAIL_API_KEY=re_...                  el valor, acá mismo
#
# Poner solo EMAIL_API_KEY sigue andando: el arranque deduce `env:EMAIL_API_KEY`.
# La forma con referencia existe porque el día que haya un gestor de secretos, lo
# único que cambia es el prefijo (`kms:`) y ninguna otra línea se entera.
EMAIL_API_KEY_REF=
EMAIL_API_KEY=

# De qué dirección salen los mensajes. **No tiene valor por defecto y no puede
# tenerlo**: Resend solo acepta un remitente de un dominio verificado en la
# cuenta, así que un ejemplo puesto acá produciría un 422 en cada envío. Poné el
# tuyo, con el formato `Nombre <casilla@tu-dominio>` o solo la casilla.
EMAIL_FROM=

# Técnicas, con valores por defecto sensatos.
#
# Los reintentos son ADEMÁS del primero y solo cubren 429, 5xx y fallos de red.
# Un TIMEOUT **no se reintenta**: no dice que el mensaje haya sido rechazado,
# dice que no contestó a tiempo, y reintentarlo podría mandarlo dos veces. El
# razonamiento completo está en apps/api/src/correo/resend.ts.
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_RETRIES=2

# ── Cobro de suscripciones ───────────────────────────────────────────────────
# Quién cobra. Dos valores, y ninguno más. Un valor desconocido NO cae a `none`:
# el servidor no arranca. Degradar en silencio acá significa emitir facturas
# durante meses sin que entre la plata, y nadie se entera hasta la conciliación.
#
#   none         sin pasarela. Es el valor por defecto y **es un modo de
#                operación**: el ciclo emite, lleva la cobranza y los cobros por
#                transferencia se registran a mano. Es lo que NEXO hace hoy.
#   mercadopago  el adaptador contra la API de suscripciones.
PAYMENTS_PROVIDER=none

# ⚠ LA VARIABLE MÁS PELIGROSA DE ESTE ARCHIVO.
#
#   sandbox     credenciales de prueba (TEST-...). No mueve plata.
#   production  credenciales reales (APP_USR-...). Mueve plata de verdad.
#
# A diferencia de ARCA, Mercado Pago **no tiene dos URLs**: producción y prueba
# comparten api.mercadopago.com y se distinguen SOLO por el prefijo del token.
# No hay ninguna barrera de red entre probar y cobrar.
#
# Por eso el ambiente se declara acá y el arranque lo compara contra el prefijo
# del token: declarar `sandbox` con un token APP_USR- impide arrancar, y al
# revés también. La comprobación no evita todos los errores, pero sí el que de
# verdad ocurre — creer que se está probando y estar cobrando.
PAYMENTS_ENV=sandbox

# El access token de la aplicación de Mercado Pago. NUNCA se loguea, no se
# persiste y no viaja en ningún error. Mismas dos formas que las otras
# credenciales, y la de la referencia es la preferida:
#
#   PAYMENTS_ACCESS_TOKEN_REF=env:PAYMENTS_ACCESS_TOKEN
#   PAYMENTS_ACCESS_TOKEN=APP_USR-...
PAYMENTS_ACCESS_TOKEN_REF=
PAYMENTS_ACCESS_TOKEN=

# El secreto con el que Mercado Pago firma las notificaciones. Es DISTINTO del
# access token y se da de alta aparte, en el panel de la aplicación.
#
# Puede faltar teniendo token, y es un estado real: se puede cobrar —Mercado
# Pago debita sola cada mes— y no se puede *enterarse*, porque las
# notificaciones llegan sin poder verificarse. En ese caso el webhook contesta
# 503 y NO 401: lo que falta es configuración de este lado, no una firma
# inválida. Un 5xx además hace que la pasarela reintente, así que las
# notificaciones de esas horas no se pierden.
PAYMENTS_WEBHOOK_SECRET_REF=
PAYMENTS_WEBHOOK_SECRET=

# A dónde vuelve el navegador después de que el cliente autoriza el medio de
# pago. Sin esto no se puede crear una suscripción.
PAYMENTS_BACK_URL=

# Técnicas. Los reintentos son ADEMÁS del primero y se aplican distinto según la
# llamada sea una lectura o una escritura: una escritura NO se reintenta ante un
# 5xx, porque el error pudo ocurrir después de haber creado la suscripción y
# repetirlo dejaría dos cobrándole a la misma empresa. Un TIMEOUT no se
# reintenta nunca. Ver apps/api/src/pagos/mercadopago.ts.
PAYMENTS_TIMEOUT_MS=10000
PAYMENTS_MAX_RETRIES=2

# Los precios de los planes y la política de cobranza NO son variables de
# entorno: se declaran en la base, con vigencia y motivo, y una vigencia nueva
# cierra la anterior en vez de pisarla. El plan del lado de la pasarela tampoco:
# vive en `payment_plan_map`, que escribe un comando y no la aplicación.
#   npm run plan:precio
#   npm run cobranza:politica

# ── ARCA ─────────────────────────────────────────────────────────────────────
# NUNCA se guarda acá la clave privada ni la Clave Fiscal del contribuyente.
# Los certificados X.509 por empresa se cifran y se guardan en la base.
#
# mock | homologacion | produccion.
# El mock se usa SI Y SOLO SI el ambiente es mock: no existe un "si falta la
# credencial, mockeá", porque eso produciría validaciones fiscales inventadas
# informadas como reales. Ver docs/api/arca-onboarding.md
ARCA_ENVIRONMENT=mock
ARCA_TIMEOUT_MS=15000

# La llave que envuelve las claves privadas de ARCA: 32 bytes en base64.
#
# Se llama LOCAL y no KMS porque eso es lo que es. Decía ARCA_KMS_KEY_ID, que
# nadie leía, y el nombre sugería un sobre que no existe: **una KEK en una
# variable de entorno vive en el mismo lugar que el dato cifrado**, así que
# protege contra un volcado de la base y contra nada más.
#
# Por eso `desenvolver()` **se niega a abrirla con NODE_ENV=production**. En
# producción hace falta un KMS de verdad, y conectarlo es el bloqueo real para
# emitir con varias empresas (docs/DESPLIEGUE.md §4.1).
#
# Si falta, se deriva una al azar en cada arranque: las credenciales cargadas
# dejan de abrirse al reiniciar.
ARCA_LOCAL_KEK=
