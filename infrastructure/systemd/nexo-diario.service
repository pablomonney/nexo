[Unit]
Description=NEXO · tareas diarias (facturación, cobranza, verificaciones)
Documentation=file:/opt/nexo/infrastructure/systemd/README.md
Requires=docker.service
After=docker.service

[Service]
Type=oneshot

# Esta es la que importa, y conviene decir por qué con todas las letras.
#
# La prueba de catorce días **solo termina si esto corre**: `vencerPruebas` se
# llama desde `correrCiclo`, `correrCiclo` desde `facturacion-ciclo.mjs`, y
# `facturacion-ciclo.mjs` desde acá y desde ningún otro lado. Sin este timer, la
# prueba no vence, la suscripción nunca pasa a SUSPENDIDA y el producto es
# gratis por tiempo indefinido — sin que ninguna pantalla lo diga, porque desde
# adentro todo está funcionando bien.
#
# Lo mismo vale para la cobranza entera: los avisos, la mora y la suspensión son
# pasos de `avanzarCobranza`, que corre en la misma llamada. Una política de
# cobranza declarada y sin este timer agendado es una política que no se ejecuta.
#
# `--env-file` es el MISMO archivo que usa docker-compose.prod.yml. La imagen no
# lleva `.env` a propósito —S-43 lo comprueba— así que las credenciales entran
# por el entorno del contenedor y nunca por la línea de comandos.
#
# Sin `-d`: la salida de la tarea es la salida de la unidad y va al journal. Es
# lo que hace que `journalctl -u nexo-diario` muestre qué se emitió y qué se
# omitió, que es el informe que alguien tiene que poder leer al día siguiente.
# ## Con qué credencial conecta, y por qué NO es la del .env
#
# `--env-file` trae el archivo entero, y su `DATABASE_URL` conecta como
# `nexo_app` — miembro de `aai_app`, el rol de la aplicación—. Ese rol está
# despojado a propósito: no tiene `SELECT` sobre `email_outbox`, ni sobre
# `payment_webhook_inbox`, ni sobre `payment_events`.
#
# Eso no es una configuración que haya que corregir: es el candado que impide
# que el administrador de una empresa cliente se marque un cargo como pagado o
# se levante una suspensión. Las tareas de acá son **del operador**, que es otra
# cosa, y por eso se arma una cadena de conexión distinta.
#
# Medido el 2026-09-16 en el ensayo aislado, con la credencial de la aplicación:
#
#     pagos-bandeja --ver   permission denied (aclcheck_error)
#     correo-bandeja --ver  permission denied for table email_outbox
#     migrate.mjs status    permission denied for schema public
#
# ## La contraseña se codifica, y esto ya costó un despliegue
#
# Una contraseña se pega en una URL y una URL tiene sintaxis. La de esta
# instalación es de 48 caracteres en base64 y contiene `/` y `+`; pegada cruda
# produce `postgresql://usuario:cla/ve@host:5432/base`, donde la barra corta el
# `userinfo` y `pg-connection-string` contesta `ERR_INVALID_URL` sin poder decir
# por qué —el input viene redactado, justamente porque lleva la credencial—.
# Pasó el 2026-09-15 en el paso de migraciones y dejó producción abajo.
#
# `encodeURIComponent` corre **dentro** del contenedor y lee la contraseña del
# entorno, no de un argumento: no aparece en `argv` de ningún proceso del host,
# ni en `ps`, ni en el journal. Es el mismo patrón, línea por línea, que
# `scripts/desplegar.sh` usa para migrar.
#
# ## Los dólares van dobles
#
# systemd expande `$VAR` y `${VAR}` en `ExecStart` contra el entorno de la
# **unidad**, que no tiene ninguna de estas variables: sin escapar, llegarían
# vacías a la shell. `$$` es el escape documentado para un dólar literal.
#
# `MFA_ENCRYPTION_KEY` sigue viniendo del `--env-file`: `config.js` la exige al
# cargarse con `NODE_ENV=production`, antes de tocar la base.
ExecStart=/usr/bin/docker run --rm \
    --name nexo-tarea-diaria \
    --network nexo \
    --env-file /opt/nexo/.env \
    --env NODE_ENV=production \
    --read-only --tmpfs /tmp:size=64m,mode=1777 \
    --security-opt no-new-privileges:true \
    --entrypoint sh \
    nexo:production \
    -c 'CLAVE=$$(node -e "process.stdout.write(encodeURIComponent(process.env.POSTGRES_PASSWORD))"); export DATABASE_URL="postgresql://$${POSTGRES_USER}:$${CLAVE}@nexo-postgres:5432/$${POSTGRES_DB}"; exec node scripts/tareas-diarias.mjs'

# Media hora. Verifica el Mayor entero y la cadena de auditoría completa, que
# crecen con los datos: el tope de cinco minutos de las otras dos la mataría a
# mitad de camino en cuanto la instalación tenga volumen.
TimeoutStartSec=1800

ExecStartPre=-/usr/bin/docker rm -f nexo-tarea-diaria

# No se reintenta: `tareas-diarias.mjs` ya sigue adelante cuando un paso falla
# —son tareas independientes— y devuelve 1 con el resumen. Reintentar la tanda
# entera volvería a correr lo que sí anduvo.
Restart=no

[Install]
WantedBy=multi-user.target
