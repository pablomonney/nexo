{
  "name": "@aai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./arca/credential-store": {
      "types": "./dist/arca/credential-store.d.ts",
      "default": "./dist/arca/credential-store.js"
    }
  },
  "dependencies": {
    "@aai/accounting-engine": "0.1.0",
    "@aai/ai-engine": "0.1.0",
    "@aai/db": "0.1.0",
    "@aai/document-engine": "0.1.0",
    "@aai/normative-engine": "0.1.0",
    "@aai/shared": "0.1.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "9.0.3",
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.2.1",
    "zod": "3.24.1",
    "@aai/tax-engine": "0.1.0",
    "@aai/bank-engine": "0.1.0",
    "@aai/financial-statements": "0.1.0",
    "@aai/arca": "0.1.0"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "node --watch dist/index.js"
  }
}
